MONGODB_URI=mongodb://localhost:27017/news-brief
PORT=3000
# Ollama must be running locally. Install the configured model with:
# ollama pull qwen2.5:7b
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_SELECTION_BATCH_SIZE=15
AI_MAX_SELECTION_INPUT_CHARS=10000
AI_MAX_DESCRIPTION_CHARS=800
AI_MAX_CONTENT_CHARS=6000
# Optional: a verified Reuters RSS URL can be enabled without code changes.
REUTERS_FEED_URL=
# ISRO's previously published RSS path is currently unavailable; enable only with
# a newly verified public RSS/Atom URL.
ISRO_FEED_URL=
